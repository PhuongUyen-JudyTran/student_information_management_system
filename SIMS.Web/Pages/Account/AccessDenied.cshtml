@page
@model SIMS.Web.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="glass-card text-center" style="width: 100%; max-width: 480px;">
        <div style="font-size: 4rem; color: var(--danger); margin-bottom: 1rem;">🛑</div>
        <h2 class="mb-2">Access Denied</h2>
        <p class="text-muted mb-4">You do not have permission to access this resource or page.</p>
        <a class="premium-btn" asp-page="/Index">Back to Home</a>
    </div>
</div>
